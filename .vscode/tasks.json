{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FastAPI: Run normally",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "uvicorn",
        "main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--env-file",
        "${workspaceFolder}/.env"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
